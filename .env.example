# ==============================================================================
# API Gateway Security Controls - Environment Configuration Template
# IMPORTANT: This file contains ONLY placeholders. NEVER commit actual production
# secrets, database credentials, or private keys to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Service Configuration (Port 8080)
# ------------------------------------------------------------------------------
SERVER_PORT=8080

# Database Configuration (MySQL)
DB_URL=jdbc:mysql://localhost:3306/api_security_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_secure_mysql_password_placeholder
DDL_AUTO=update
SHOW_SQL=false

# JWT Authentication Secret (Must be a cryptographically secure 256-bit Base64-encoded string in production)
# Example generation: openssl rand -base64 32
JWT_SECRET=your_base64_encoded_256_bit_jwt_secret_key_placeholder
JWT_EXPIRATION_MS=86400000

# Inter-Service Authentication Key (Shared between Gateway and Backend)
INTERNAL_GATEWAY_KEY=your_secure_internal_gateway_shared_key

# CORS Allowed Origins (Comma-separated list of trusted origins)
CORS_ALLOWED_ORIGINS=http://localhost:5174,http://localhost:5173,http://localhost:3000,http://127.0.0.1:5174,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# Spring Cloud Gateway Service Configuration (Port 8081 / Render PORT)
# ------------------------------------------------------------------------------
SERVER_PORT=8081
BACKEND_SERVICE_URL=http://localhost:8080
SBMS_BACKEND_URL=https://sri-balaji-medi-systems.onrender.com

# Gateway IP Filtering Policies
IP_FILTER_ENABLED=true
IP_BLACKLIST_HEALTH=
IP_WHITELIST_HEALTH=
IP_BLACKLIST_AUTH=
IP_WHITELIST_AUTH=
IP_BLACKLIST_PRODUCTS=
IP_WHITELIST_PRODUCTS=
IP_BLACKLIST_ORDERS=
IP_WHITELIST_ORDERS=
IP_BLACKLIST_PAYMENTS=
IP_WHITELIST_PAYMENTS=
IP_BLACKLIST_USERS=
IP_WHITELIST_USERS=
IP_BLACKLIST_AUDIT=
IP_WHITELIST_AUDIT=
IP_BLACKLIST_ARSA=
IP_WHITELIST_ARSA=

# Gateway Rate Limiting Policies (Capacity, Refill Tokens, Duration in Seconds)
RATE_LIMIT_HEALTH_CAPACITY=30
RATE_LIMIT_HEALTH_REFILL=30
RATE_LIMIT_HEALTH_DURATION=60

RATE_LIMIT_AUTH_CAPACITY=10
RATE_LIMIT_AUTH_REFILL=10
RATE_LIMIT_AUTH_DURATION=60

RATE_LIMIT_PRODUCTS_CAPACITY=50
RATE_LIMIT_PRODUCTS_REFILL=50
RATE_LIMIT_PRODUCTS_DURATION=60

RATE_LIMIT_ORDERS_CAPACITY=20
RATE_LIMIT_ORDERS_REFILL=20
RATE_LIMIT_ORDERS_DURATION=60

RATE_LIMIT_PAYMENTS_CAPACITY=10
RATE_LIMIT_PAYMENTS_REFILL=10
RATE_LIMIT_PAYMENTS_DURATION=60

RATE_LIMIT_USERS_CAPACITY=15
RATE_LIMIT_USERS_REFILL=15
RATE_LIMIT_USERS_DURATION=60

RATE_LIMIT_AUDIT_CAPACITY=30
RATE_LIMIT_AUDIT_REFILL=30
RATE_LIMIT_AUDIT_DURATION=60

RATE_LIMIT_ARSA_CAPACITY=30
RATE_LIMIT_ARSA_REFILL=30
RATE_LIMIT_ARSA_DURATION=60

# ------------------------------------------------------------------------------
# Frontend Dashboard Configuration (Vite on Port 5174)
# ------------------------------------------------------------------------------
# Leave empty to use default Vite proxy to Gateway, or specify explicit Gateway origin:
VITE_API_URL=
